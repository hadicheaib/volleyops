# ─── Required ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ─── CORS (comma-separated list of allowed origins) ───────────────────────────
CORS_ORIGINS=http://localhost

# ─── App URL (used in password-reset emails) ──────────────────────────────────
APP_URL=http://localhost

# ─── JWT expiry (optional, default 15m) ───────────────────────────────────────
JWT_EXPIRES_IN=15m

# ─── SMTP (optional – leave blank to skip email sending) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Anthropic AI (optional – needed for AI placement feature) ────────────────
ANTHROPIC_API_KEY=
